<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string-array name="greetings_any">
        <item>كيف يمكنني مساعدتك؟</item>
        <item>ما الذي يشغل بالك؟</item>
        <item>ما الذي نعمل عليه اليوم؟</item>
        <item>اسألني أي شيء</item>
        <item>من أين نبدأ؟</item>
        <item>ماذا تحتاج؟</item>
        <item>أنا جاهز عندما تكون مستعداً</item>
        <item>ما الذي سنفعله اليوم؟</item>
        <item>هل لديك سؤال؟</item>
        <item>لننجز شيئاً مفيداً</item>
    </string-array>
    <string-array name="greetings_morning">
        <item>صباح الخير! كيف أساعدك؟</item>
        <item>صباح النور! ما خطة اليوم؟</item>
        <item>يوم جديد وأفكار جديدة؟</item>
        <item>ما رأيك أن نبدأ بشيء جديد؟</item>
        <item>صباح الخير! من أين نبدأ؟</item>
        <item>استيقظنا ليوم جديد! ما الأخبار؟</item>
        <item>يوم جديد، ماذا سنفعل؟</item>
        <item>صباح الخير! أنا جاهز لمساعدتك</item>
        <item>هل لديك خطط لهذا اليوم؟</item>
        <item>بداية مبكرة! ماذا تحتاج؟</item>
    </string-array>
    <string-array name="greetings_day">
        <item>نهارك سعيد! كيف أساعدك؟</item>
        <item>أهلاً! كيف يسير يومك؟</item>
        <item>ما الذي يشغل وقتك هذا النهار؟</item>
        <item>استراحة قصيرة؟ ما الذي تحتاجه؟</item>
        <item>مرحباً! ما المهمة التي سننجزها؟</item>
        <item>يوم مزدحم؟ دعني أساعدك</item>
        <item>هل لديك سؤال خلال استراحتك؟</item>
        <item>نهار سعيد! ما الجديد؟</item>
        <item>لنستفد من بقية اليوم</item>
        <item>ما المهمة التي يمكنني إنجازها عنك؟</item>
    </string-array>
    <string-array name="greetings_evening">
        <item>مساء الخير! كيف أساعدك؟</item>
        <item>مساء النور! ما الذي يشغل بالك؟</item>
        <item>كيف كان يومك؟</item>
        <item>هل تستعد للراحة أم لبدء شيء جديد؟</item>
        <item>مساء الخير! ماذا سنفعل؟</item>
        <item>هل لديك خطط للمساء؟ لنتحدث</item>
        <item>ما زلت تعمل؟ ماذا تحتاج؟</item>
        <item>حان وقت الراحة أم وقت الإنجاز؟</item>
        <item>أهلاً بك في هذا المساء! ما الأخبار؟</item>
        <item>ما الذي سنكتشفه الليلة؟</item>
    </string-array>
    <string-array name="greetings_night">
        <item>ما زلت مستيقظاً؟ ما الذي يشغل بالك؟</item>
        <item>أفكار آخر الليل؟</item>
        <item>لا تستطيع النوم؟ لنتحدث</item>
        <item>ساهر في هذا الوقت؟ كيف أساعدك؟</item>
        <item>ما زال الليل في أوله، ما الأخبار؟</item>
        <item>تعمل حتى وقت متأخر؟</item>
        <item>هدوء الليل مناسب للتفكير، ما الذي يشغلك؟</item>
        <item>لقد تأخر الوقت، ما خطتنا؟</item>
        <item>أفكار منتصف الليل مرحّب بها</item>
        <item>مستيقظ تماماً؟ ماذا سنفعل؟</item>
    </string-array>
</resources>
